  "LEFT LANE CLOSED AHEAD",
  "ROAD UNDER CONSTRUCTION",
  "SHOULDER WORK AHEAD",
  "ONE LANE AHEAD",
  "ROAD CLOSED AHEAD",
  "ROAD WORK",
  "HEAVY MACHINERY AHEAD",
  "TEMPORARY ROUTE AHEAD",
  "DETOUR AHEAD",
  "ROAD WORK AHEAD",
  "RIGHT LANE CLOSED AHEAD",
  "MAIN ROAD UNDER REPAIR IN 500 m",
  "END OF ROAD REPAIR ZONE",
  "DETOUR"
],

"senales_de_informacion": {
  "description": "Information signs guide drivers along their route. They are typically rectangular and use blue-and-white or green-and-white color schemes.",

  "classification": [
    "Route Identification: indicates the highway or road number.",
    "Destination: indicates distances to cities or destinations.",
    "General Information: identifies rivers, towns, and other locations.",
    "Recommendations: encourage safe driving practices.",
    "Services and Tourism: indicate available services such as restaurants, gas stations, museums, and tourist attractions."
  ],

  "examples": [
    "HANDICRAFTS",
    "HOTEL",
    "AUTO REPAIR SHOP",
    "GAS STATION",
    "AIRPORT",
    "LAKE",
    "SUN & BEACH",
    "RED CROSS",
    "RESTAURANT",
    "TELEPHONE",
    "RECREATIONAL AREA",
    "PUBLIC SWIMMING AREA"
  ]
},

"senalamiento_horizontal": {
  "description": "Horizontal signs are pavement markings painted on the roadway. They are white or yellow and each color has a specific meaning.",

  "pintura_de_color_blanca": "White markings indicate traffic moving in the same direction. They are also used for stop lines, yield lines, and speed markings.",

  "pintura_de_color_amarillo": "Yellow markings separate opposing traffic lanes. They are also used for no-parking zones, bus stops, and fire hydrants."
}